  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "export:demo": "EXPO_PUBLIC_CAREEROS_DEMO=1 expo export --platform web --output-dir dist-demo && node scripts/relativise.mjs dist-demo",
