# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets first:
#   taxvault newkey              -> TAXVAULT_MASTER_KEY
#   python -c "import secrets;print(secrets.token_urlsafe(48))"  -> SESSION_SECRET
#
# The master key is the one value you cannot lose and cannot rotate casually:
# everything sealed under it -- every SSN, every bank account -- is unreadable
# without it. Put it in a secret manager with versioning, not in a file on a
# laptop.

TAXVAULT_ENV=staging
POSTGRES_PASSWORD=
TAXVAULT_MASTER_KEY=
TAXVAULT_SESSION_SECRET=

# Delivery. Without email nobody can sign in; without SMS nobody can finish
# identity verification, because that gate requires a verified mobile.
TAXVAULT_SMTP_HOST=
TAXVAULT_SMTP_PORT=587
TAXVAULT_SMTP_FROM=
TAXVAULT_SMTP_USER=
TAXVAULT_SMTP_PASSWORD=

TAXVAULT_SMS_ACCOUNT_SID=
TAXVAULT_SMS_AUTH_TOKEN=
TAXVAULT_SMS_FROM=

# Who the practice is. These appear on every estimate a client takes away and
# on their fee receipt, so fill them in before the first real client. The PTIN
# is the preparer identification number the IRS issues; a paid preparer must
# have one.
TAXVAULT_PRACTICE_NAME=
TAXVAULT_PRACTICE_ADDRESS=
TAXVAULT_PRACTICE_PHONE=
TAXVAULT_PREPARER_NAME=
TAXVAULT_PREPARER_PTIN=

# Transport. Set TRUSTED_PROXIES to your load balancer, or * if it is the only
# way in. Until it is set, X-Forwarded-For is ignored -- which is safe, but it
# counts every client against the proxy's single address.
TAXVAULT_FORCE_HSTS=1
TAXVAULT_TRUSTED_PROXIES=*

# NEVER set these in a real deployment.
# TAXVAULT_DEV_CODES=1
